GROQ_MODEL=openai/gpt-oss-120b

# ---------------- Authorization settings (you change these in class) ----------------
# After any change run:  docker compose up -d
# legacy  = the bank's old hard-coded role checks (the "before" state)
# openfga = every decision is made by OpenFGA
AUTHZ_MODE=legacy
FGA_API_URL=http://openfga:8090
FGA_STORE_ID=
FGA_MODEL_ID=
# Mirror Keycloak group membership into OpenFGA tuples at every login
FGA_SYNC_KEYCLOAK_GROUPS=false
# When an AI agent acts for a person, check the person too (fixes the confused deputy)
FGA_ON_BEHALF_OF=false
# How often the rogue "fake" agent probes the API
ROGUE_INTERVAL_SECONDS=45
